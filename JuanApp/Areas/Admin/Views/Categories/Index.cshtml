@model List<JuanApp.Areas.Admin.ViewModels.CategoryVM.CategoryListVM>
@{ ViewData["Title"]="Categories"; }
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-0 text-gray-800">Categories</h1><p class="text-muted mb-0">Organize the Juan collection.</p></div><a class="btn btn-primary btn-sm shadow-sm" asp-action="Create"><i class="fas fa-plus mr-2"></i>New category</a></div>
<div class="card shadow mb-4"><div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">All categories</h6></div><div class="card-body"><div class="table-responsive"><table class="table table-bordered" id="dataTable"><thead><tr><th>Name</th><th>Description</th><th>Products</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="font-weight-bold">@item.Name</td><td>@item.Description</td><td>@item.ProductCount</td><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="admin-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this category?')"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr>}</tbody></table></div></div></div>
