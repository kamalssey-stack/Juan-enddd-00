@model JuanApp.Areas.Admin.ViewModels.ProductVM.ProductDetailAdminVM
@{ ViewData["Title"]=Model.Product.Name; var image=Model.Product.Images.FirstOrDefault(i=>i.IsMain)?.ImageUrl??"product-1.jpg"; }
<div class="mb-4"><a asp-action="Index" class="small">← Products</a><div class="d-flex justify-content-between align-items-center"><h1 class="h3 mt-2 text-gray-800">@Model.Product.Name</h1><a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Product.Id">Edit product</a></div></div><div class="card shadow mb-4"><div class="card-body row"><div class="col-md-4"><img class="img-fluid rounded" src="~/assets/img/product/@image" alt="@Model.Product.Name"/></div><div class="col-md-8"><p><strong>SKU:</strong> @Model.Product.SKU</p><p><strong>Category:</strong> @Model.Product.Category?.Name</p><p><strong>Price:</strong> $@Model.Product.DiscountPrice.ToString("N2")</p><p><strong>Stock:</strong> @Model.Product.StockCount</p><p><strong>Description:</strong> @Model.Product.Description</p></div></div></div>
