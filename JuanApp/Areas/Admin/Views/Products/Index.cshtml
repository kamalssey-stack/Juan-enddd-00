@model List<JuanApp.Areas.Admin.ViewModels.ProductVM.ProductListVM>
@{ ViewData["Title"]="Products"; }
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-0 text-gray-800">Products</h1><p class="text-muted mb-0">Manage the pairs in your store.</p></div><a class="btn btn-primary btn-sm shadow-sm" asp-action="Create"><i class="fas fa-plus mr-2"></i>Add product</a></div>
<div class="card shadow mb-4"><div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Product inventory</h6></div><div class="card-body"><div class="table-responsive"><table class="table table-bordered" id="dataTable"><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Price</th><th>Stock</th><th>Flags</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><div class="d-flex align-items-center"><img class="admin-product-thumb" src="~/assets/img/product/@item.MainImageUrl" alt=""/><a class="font-weight-bold" asp-action="Detail" asp-route-id="@item.Id">@item.Name</a></div></td><td>@item.SKU</td><td>@item.CategoryName</td><td>$@item.DiscountPrice.ToString("N2")</td><td><span class="@(item.StockCount<5?"text-danger font-weight-bold":"")">@item.StockCount</span></td><td>@(item.IsFeatured?"Featured · ":"")@(item.IsNew?"New · ":"")@(item.IsBestSeller?"Best seller":"")</td><td class="admin-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this product?')"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr>}</tbody></table></div></div></div>
