@model JuanApp.Areas.Admin.ViewModels.ProductVM.ProductUpdateVM
@{ ViewData["Title"]="Edit product"; var categories=ViewBag.Categories as IEnumerable<JuanApp.Models.Category> ?? Enumerable.Empty<JuanApp.Models.Category>(); }
<div class="mb-4"><a asp-action="Index" class="small">← Products</a><h1 class="h3 mt-2 text-gray-800">Edit product</h1></div><div class="card shadow mb-4"><div class="card-body admin-form"><form asp-action="Edit" method="post" enctype="multipart/form-data"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="form-row"><div class="form-group col-md-8"><label asp-for="Name">Product name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger small"></span></div><div class="form-group col-md-4"><label asp-for="SKU">SKU</label><input asp-for="SKU" class="form-control"/></div></div><div class="form-group"><label asp-for="Description">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="form-row"><div class="form-group col-md-3"><label asp-for="Price">Price</label><input asp-for="Price" class="form-control"/></div><div class="form-group col-md-3"><label asp-for="DiscountPercent">Discount %</label><input asp-for="DiscountPercent" class="form-control"/></div><div class="form-group col-md-3"><label asp-for="StockCount">Stock</label><input asp-for="StockCount" class="form-control"/></div><div class="form-group col-md-3"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" class="form-control"><option value="">Choose category</option>@foreach(var category in categories){<option value="@category.Id">@category.Name</option>}</select></div></div><p class="small text-muted">Leave an image empty to keep the current image.</p><div class="form-row"><div class="form-group col-md-4"><label>Main image</label><input asp-for="MainImage" type="file" class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp"/></div><div class="form-group col-md-4"><label>Hover image</label><input asp-for="HoverImage" type="file" class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp"/></div><div class="form-group col-md-4"><label>Additional images</label><input asp-for="AdditionalImages" type="file" multiple class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp"/></div></div><div class="form-row"><div class="form-check mx-3"><input asp-for="IsFeatured" class="form-check-input"/><label asp-for="IsFeatured" class="form-check-label">Featured</label></div><div class="form-check mx-3"><input asp-for="IsNew" class="form-check-input"/><label asp-for="IsNew" class="form-check-label">New arrival</label></div><div class="form-check mx-3"><input asp-for="IsBestSeller" class="form-check-input"/><label asp-for="IsBestSeller" class="form-check-label">Best seller</label></div></div><div class="mt-4"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-light ml-2" asp-action="Index">Cancel</a></div></form></div></div>
