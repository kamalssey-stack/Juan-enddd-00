@model JuanApp.Areas.Admin.ViewModels.ProductVM.ProductCreateVM
@{
    ViewData["Title"] = "Add product";
    var categories = ViewBag.Categories as IEnumerable<JuanApp.Models.Category> ?? Enumerable.Empty<JuanApp.Models.Category>();
}

<div class="mb-4">
    <a asp-action="Index" class="small">← Products</a>
    <h1 class="h3 mt-2 text-gray-800">Add product</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-body admin-form">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-row">
                <div class="form-group col-md-8">
                    <label asp-for="Name">Product name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="SKU">SKU</label>
                    <input asp-for="SKU" class="form-control" />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" type="number" min="0.01" max="100000" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                    <small class="form-text text-muted">Enter a value from 0.01 to 100,000.</small>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="DiscountPercent">Discount %</label>
                    <input asp-for="DiscountPercent" type="number" min="0" max="100" step="1" class="form-control" />
                    <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="StockCount">Stock</label>
                    <input asp-for="StockCount" type="number" min="0" max="10000" step="1" class="form-control" />
                    <span asp-validation-for="StockCount" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="CategoryId">Category</label>
                    <select asp-for="CategoryId" class="form-control">
                        <option value="0">Choose category</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="MainImage">Main image</label>
                    <input asp-for="MainImage" type="file" class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp" />
                    <span asp-validation-for="MainImage" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="HoverImage">Hover image</label>
                    <input asp-for="HoverImage" type="file" class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp" />
                    <span asp-validation-for="HoverImage" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="AdditionalImages">Additional images</label>
                    <input asp-for="AdditionalImages" type="file" multiple class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp" />
                    <span asp-validation-for="AdditionalImages" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-check mx-3">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label">Featured</label>
                </div>
                <div class="form-check mx-3">
                    <input asp-for="IsNew" class="form-check-input" />
                    <label asp-for="IsNew" class="form-check-label">New arrival</label>
                </div>
                <div class="form-check mx-3">
                    <input asp-for="IsBestSeller" class="form-check-input" />
                    <label asp-for="IsBestSeller" class="form-check-label">Best seller</label>
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary" type="submit">Save product</button>
                <a class="btn btn-light ml-2" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
