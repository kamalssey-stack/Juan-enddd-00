@model List<JuanApp.Areas.Admin.ViewModels.OrderVM.OrderListVM>
@{ ViewData["Title"]="Orders"; }
<div class="mb-4"><h1 class="h3 mb-0 text-gray-800">Orders</h1><p class="text-muted mb-0">Every Juan order, all in one place.</p></div><div class="card shadow mb-4"><div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">All sales</h6></div><div class="card-body"><div class="table-responsive"><table class="table table-bordered" id="dataTable"><thead><tr><th>Order</th><th>Customer</th><th>Email</th><th>Phone</th><th>Items</th><th>Total</th><th>Status</th><th>Placed</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Detail" asp-route-id="@item.Id">@item.OrderNumber</a></td><td>@item.CustomerName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.ItemCount</td><td>$@item.TotalAmount.ToString("N2")</td><td><span class="badge badge-status">@item.Status</span></td><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></div></div>
