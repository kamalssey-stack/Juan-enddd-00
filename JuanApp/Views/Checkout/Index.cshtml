@model JuanApp.ViewModels.Checkout.CheckoutVM
@{ ViewData["Title"] = "Checkout"; }
<section class="page-hero page-hero--compact"><span class="eyebrow">Almost yours</span><h1>Check <em>out.</em></h1></section>
<section class="section-wrap checkout-layout">
    <form asp-action="Index" method="post" class="checkout-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <h2>Delivery details</h2>
        <div class="form-grid"><label>Full name<input asp-for="CustomerName" autocomplete="name"/><span asp-validation-for="CustomerName"></span></label><label>Email<input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span></label><label>Phone<input asp-for="Phone" autocomplete="tel"/><span asp-validation-for="Phone"></span></label><label>City<input asp-for="City" autocomplete="address-level2"/><span asp-validation-for="City"></span></label><label class="form-grid__wide">Address<input asp-for="Address" autocomplete="street-address"/><span asp-validation-for="Address"></span></label><label>Postal code<input asp-for="PostalCode" autocomplete="postal-code"/></label><label class="form-grid__wide">Order note<textarea asp-for="OrderNote" rows="3" placeholder="Anything we should know?"></textarea></label></div>
        <button class="button button--wide" type="submit">Place order · $@Model.Basket.TotalAmount.ToString("0.00")</button>
    </form>
    <aside class="checkout-summary"><span class="eyebrow">Your order</span>@foreach(var item in Model.Basket.Items){<div class="checkout-line"><span>@item.ProductName <small>× @item.Count</small></span><strong>$@item.SubTotal.ToString("0.00")</strong></div>}<div class="checkout-total"><span>Total</span><strong>$@Model.Basket.TotalAmount.ToString("0.00")</strong></div><p>Payment on delivery</p></aside>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
