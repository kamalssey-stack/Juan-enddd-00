@model JuanApp.ViewModels.Account.ForgotPasswordVM
@{ ViewData["Title"] = "Reset password"; }
<section class="account-page"><div class="account-card"><span class="eyebrow">It happens</span><h1>Find your<br/><em>way back.</em></h1><p>Enter your email and we’ll send a password reset link if an account matches.</p><form asp-action="ForgotPassword" method="post"><label>Email<input asp-for="Email" autocomplete="email"/></label><span asp-validation-for="Email"></span><button class="button button--wide" type="submit">Send reset link</button></form><p class="account-foot"><a asp-action="Login">← Back to sign in</a></p></div></section>
