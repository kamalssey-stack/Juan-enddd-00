@model JuanApp.ViewModels.Account.ResetPasswordVM
@{ ViewData["Title"] = "Choose a new password"; }
<section class="account-page"><div class="account-card"><span class="eyebrow">Fresh start</span><h1>Choose a<br/><em>new password.</em></h1><form asp-action="ResetPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="UserId" type="hidden"/><input asp-for="Token" type="hidden"/><label>New password<input asp-for="Password" autocomplete="new-password"/></label><span asp-validation-for="Password"></span><label>Confirm password<input asp-for="ConfirmPassword" autocomplete="new-password"/></label><span asp-validation-for="ConfirmPassword"></span><button class="button button--wide" type="submit">Update password</button></form></div></section>
