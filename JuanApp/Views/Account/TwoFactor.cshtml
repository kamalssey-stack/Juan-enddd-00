@model JuanApp.ViewModels.Account.TwoFactorVM
@{ ViewData["Title"] = "Two-step verification"; }
<section class="account-page"><div class="account-card"><span class="eyebrow">One more step</span><h1>Check your<br/><em>authenticator.</em></h1><form asp-action="TwoFactor" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><input asp-for="RememberMe" type="hidden"/><label>6-digit code<input asp-for="Code" inputmode="numeric" autocomplete="one-time-code"/></label><label class="remember-line"><input asp-for="RememberMachine"/> Remember this device</label><button class="button button--wide" type="submit">Verify code</button></form></div></section>
