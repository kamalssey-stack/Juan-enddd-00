@model JuanApp.ViewModels.Account.AccountRegisterVM
@{ ViewData["Title"] = "Create account"; }
<section class="account-page"><div class="account-card"><span class="eyebrow">Make yourself at home</span><h1>Join the<br/><em>Juan crew.</em></h1><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label>Full name<input asp-for="FullName" autocomplete="name"/></label><span asp-validation-for="FullName"></span><label>Username<input asp-for="Username" autocomplete="username"/></label><span asp-validation-for="Username"></span><label>Email<input asp-for="Email" autocomplete="email"/></label><span asp-validation-for="Email"></span><label>Password<input asp-for="Password" autocomplete="new-password"/></label><span asp-validation-for="Password"></span><label>Confirm password<input asp-for="ConfirmPassword" autocomplete="new-password"/></label><span asp-validation-for="ConfirmPassword"></span><button class="button button--wide" type="submit">Create account</button></form><p class="account-foot">Already a member? <a asp-action="Login">Sign in</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
