@model JuanApp.ViewModels.Shop.ProductDetailVM
@{ ViewData["Title"] = Model.Product.Name; var heroImage = Model.Product.Images.FirstOrDefault(i=>i.IsMain)?.ImageUrl ?? Model.Product.Images.FirstOrDefault()?.ImageUrl ?? "product-1.jpg"; }
<section class="section-wrap detail-layout">
    <div class="detail-image"><img src="~/assets/img/product/@heroImage" alt="@Model.Product.Name"/></div>
    <div class="detail-info"><span class="eyebrow">@(Model.Product.Category?.Name ?? "Juan collection")</span><h1>@Model.Product.Name</h1><div class="detail-rating">★ @((Model.Product.Ratings.Any()) ? Model.Product.Ratings.Average(r=>r.Rating).ToString("0.0") : "New") <span>· @Model.Product.Ratings.Count reviews</span></div><div class="detail-prices"><strong class="detail-price">$@Model.Product.DiscountPrice.ToString("0.00")</strong>@if (Model.Product.DiscountPercent is > 0) { <del class="detail-original-price">$@Model.Product.Price.ToString("0.00")</del><span class="detail-sale-badge">Save @Model.Product.DiscountPercent%</span> }</div><p>@Model.Product.Description</p><p class="stock-note">@(Model.Product.StockCount > 0 ? $"In stock · {Model.Product.StockCount} available" : "Currently out of stock")</p>
        @if(Model.Product.StockCount>0){<form asp-controller="Basket" asp-action="Add" method="post" class="detail-buy"><input type="hidden" name="productId" value="@Model.Product.Id"/><label>Qty <input type="number" name="count" min="1" max="@Math.Min(Model.Product.StockCount,50)" value="1"/></label><button class="button" type="submit">Add to bag <span>↗</span></button></form>}
        <div class="detail-perks"><span>Easy everyday comfort</span><span>Secure checkout</span><span>Carefully chosen materials</span></div>
    </div>
</section>
@if(Model.RelatedProducts.Any()){<section class="section-wrap"><div class="section-heading"><div><span class="eyebrow">More to love</span><h2>You may also like</h2></div></div><div class="product-grid">@foreach(var product in Model.RelatedProducts){<partial name="_ProductCardPartial" model="product"/>}</div></section>}
